dev.off()
# install.packages("ggplot2")   # 安装 ggplot2（已注释）
library(ggplot2)            # 加载 ggplot2，用于绘图
inputFile = "input.txt"     # 输入文件：差异分析结果，含 logFC 和 fdr 列
outFile = "图.pdf"          # 输出文件：火山图 PDF
logFCfilter = 1             # logFC 过滤阈值
fdrFilter = 0.05            # 校正后 p 值（FDR）阈值
# setwd("")                 # 设置工作目录（已注释）
# ==================== 读取数据 ====================
rt = read.table(inputFile, sep = "\t", header = T, check.names = F)
# 读取制表符分隔的文件，第一行为列名，不修改列名
# ==================== 定义显著性分类 ====================
Significant = ifelse(
(rt$fdr < fdrFilter & abs(rt$logFC) > logFCfilter),   # 满足 FDR 和 logFC 阈值
ifelse(rt$logFC > logFCfilter, "Up", "Down"),         # logFC > 阈值为 Up，否则 Down
"Not"                                                 # 不满足阈值则为 Not
)
# 结果：Significant 是一个字符向量，值为 "Up"、"Down" 或 "Not"
# ==================== 绘制火山图 ====================
p = ggplot(rt, aes(logFC, -log10(fdr))) +     # x=logFC，y=-log10(fdr)
geom_point(aes(col = Significant)) +      # 散点，颜色按显著性分类
scale_color_manual(values = c("green", "black", "red")) +
# 手动指定颜色：Down 绿色，Not 黑色，Up 红色
# 注意：颜色顺序按因子水平字母排序，通常为 Down、Not、Up
labs(title = " ") +                       # 标题为空
theme(plot.title = element_text(size = 16, hjust = 0.5, face = "bold"))
# 标题居中、加粗、字号 16
p = p + theme_bw()    # 叠加黑白主题
p                     # 在 RStudio 面板中显示图形
# ==================== 输出图片 ====================
pdf(outFile, width = 5.5, height = 4.5)   # 打开 PDF 设备
print(p)
dev.off()
