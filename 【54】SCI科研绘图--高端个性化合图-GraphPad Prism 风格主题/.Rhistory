width = 0.8) +               # 柱宽 0.8
labs(x = NULL, y = NULL) +            # 不显示轴标签
scale_fill_manual(values = c("#006533", "black")) +   # 手动指定填充色
scale_y_discrete(limits = get_taxa_name(tree) %>% rev()) +  # y 轴顺序
scale_x_continuous(guide = "prism_offset_minor",      # x 轴用 Prism 风格次刻度
position = "top") +                # x 轴放在顶部
theme_prism() +                                        # Prism 主题
theme(axis.text.y = element_blank(),                   # 不显示 y 轴文字
axis.text.x = element_text(color = "black",      # x 轴文字黑色
size = 8),            # 字号 8
axis.line.y = element_blank(),                   # 不显示 y 轴线
axis.ticks.y = element_blank(),                  # 不显示 y 轴刻度
axis.ticks.x = element_line(size = 0.5),         # x 轴刻度线宽 0.5
axis.line.x = element_line(size = 0.5))          # x 轴线宽 0.5
# ==================== 组合三张图 ====================
plot <- (tree + plot2 + plot1) +                 # 用 patchwork 横向拼接三张图
plot_layout(widths = c(1, 0.5, 4))             # 宽度比例：1 : 0.5 : 4
# ==================== 图形注释 ====================
ggdraw(plot) +                                    # 用 cowplot 把拼接图转为可注释对象
draw_text(text = "Total number\nof pathways",   # 添加文字
size = 10,                            # 字号
x = 0.24, y = 0.68,                   # 位置（相对坐标 0-1）
color = "black") +                    # 颜色
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#55BF93",   # 添加色块
col = "#55BF93",     # 边框色
alpha = 0.2)),       # 透明度
x = 0.08, y = 0.81,                   # 位置
height = 0.03, width = 0.08) +        # 高度、宽度
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#E9972A", col = "#E9972A", alpha = 0.2)),
x = 0.08, y = 0.78, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#205FA7", col = "#205FA7", alpha = 0.2)),
x = 0.08, y = 0.75, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#DD5AA3", col = "#DD5AA3", alpha = 0.2)),
x = 0.08, y = 0.72, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#F9CC13", col = "#F9CC13", alpha = 0.2)),
x = 0.08, y = 0.69, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#91409A", col = "#91409A", alpha = 0.2)),
x = 0.08, y = 0.66, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "grey", col = "grey", alpha = 0.2)),
x = 0.08, y = 0.63, height = 0.03, width = 0.08) +
draw_text(text = "SCFA", size = 5, x = 0.12, y = 0.825, color = "black") +   # 注释文字. text 中size设置文字大小
draw_text(text = "SCFA-Others", size = 5, x = 0.12, y = 0.795, color = "black") +
draw_text(text = "Aliphatic amines", size = 5, x = 0.12, y = 0.765, color = "black") +
draw_text(text = "Aromatic", size = 5, x = 0.12, y = 0.735, color = "black") +
draw_text(text = "npAA", size = 5, x = 0.12, y = 0.705, color = "black") +
draw_text(text = "Other", size = 5, x = 0.12, y = 0.675, color = "black") +
draw_text(text = "Energy-MGCs", size = 5, x = 0.12, y = 0.645, color = "black") +
# 绘图图例框-1：>50% 和 <=50% 的图例
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),   # 白底黑框
x = 0.18, y = 0.81, height = 0.02, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.79, height = 0.02, width = 0.12) +
draw_line(x = c(0.2, 0.2), y = c(0.79, 0.83),   # 画竖线
size = 0.5, color = "black") +
draw_text(text = ">50% bacteria", size = 5, x = 0.255, y = 0.82, color = "black") +
draw_text(text = "<=50% bacteria", size = 5, x = 0.255, y = 0.8, color = "black") +
# 绘图图例框-2：Primary metabolism 和 Energy-MGCs 的图例
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.75, height = 0.02, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.73, height = 0.02, width = 0.12) +
draw_line(x = c(0.2, 0.2), y = c(0.73, 0.77), size = 0.5, color = "black") +
draw_text(text = "Primary metabolism", size = 5, x = 0.254, y = 0.758, color = "black") +
draw_text(text = "Energy-MGCs", size = 5, x = 0.254, y = 0.738, color = "black") +
# 注释图例点：大圆点、小圆点、两个方块
draw_grob(grid::grid.circle(gp = grid::gpar(fill = "black", col = "black")),   # 大圆点
x = 0.13, y = 0.812, height = 0.016, width = 0.12) +
draw_grob(grid::grid.circle(gp = grid::gpar(fill = "black", col = "black")),   # 小圆点
x = 0.13, y = 0.792, height = 0.013, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#006533", col = "black")),   # 深绿色方块
x = 0.18, y = 0.75, height = 0.02, width = 0.02) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "black", col = "black")),     # 黑色方块
x = 0.18, y = 0.73, height = 0.02, width = 0.02)
# ==================== 保存图片 ====================
ggsave("组合图2.pdf",           # 文件名
width = 26,             # 宽度 26 英寸
height = 26,            # 高度 26 英寸
dpi = 300)              # 分辨率 300 dpi
# ==================== 加载 R 包 ====================
library(tidyverse)   # 加载 tidyverse，包含 dplyr、tidyr、ggplot2、readr 等
library(readxl)      # 加载 readxl，用于读取 Excel 文件
library(ggprism)     # 加载 ggprism，提供 GraphPad Prism 风格主题和坐标轴
library(ggtree)      # 加载 ggtree，用于绘制聚类树/系统发育树
library(cowplot)     # 加载 cowplot，用于图形组合和注释
library(patchwork)   # 加载 patchwork，用于图形拼接
# ==================== 读取数据 ====================
df <- read_excel("41587_2023_1675_MOESM4_ESM.xlsx",   # Excel 文件名
sheet = 1)                            # 读取第 1 个工作表
# ==================== 构建聚类树 ====================
tree <- hclust(dist(df %>% column_to_rownames(var = "Bacteria"))) %>%
# df %>% column_to_rownames(var = "Bacteria")：把 Bacteria 列转为行名
# dist()：计算距离矩阵（默认欧氏距离）
# hclust()：对距离矩阵做层次聚类
ggtree(layout = "rectangular",        # 用 ggtree 绘制，矩形布局
branch.length = "none") +      # 不按枝长比例绘制
geom_tiplab(size = 3.5,               # 叶节点标签：字体大小 3.5
family = "Times",         # 字体：Times
fontface = "italic",      # 字体样式：斜体
color = "black") +        # 颜色：黑色
xlim(0, 20)                           # x 轴范围：0 到 20
# ==================== 读取分组数据 ====================
group <- read_excel("41587_2023_1675_MOESM4_ESM.xlsx",   # 同一个 Excel 文件
sheet = 2)                            # 读取第 2 个工作表
# ==================== 数据整理 ====================
df1 <- df %>%
pivot_longer(-Bacteria) %>%           # 宽转长：除 Bacteria 外都转成长表
filter(value != 0) %>%                # 只保留 value 不为 0 的行
mutate(type = case_when(value > 0.5 ~ ">50% bacteria",       # value > 0.5 的标记
value <= 0.5 ~ "<=50% bacteria")) %>% # 否则标记为 <=50%
left_join(., group, by = "name")      # 左连接：按 name 关联 group 数据
# ==================== 固定分组顺序 ====================
df1$group <- factor(df1$group,                   # 把 group 列转为因子
levels = group$group %>% unique())   # 水平顺序为 group 列的唯一值
# ==================== 绘制图 plot1（点图） ====================
plot1 <- df1 %>%
ggplot(aes(name, Bacteria,                     # x 轴为 name，y 轴为 Bacteria
fill = type,                        # 填充色按 type 映射
color = group)) +                   # 边框色按 group 映射
geom_point(data = df1 %>% filter(type == ">50% bacteria"),   # 只取 >50% 的数据
size = 4.5,                         # 点大小 4.5
show.legend = F) +                  # 不显示图例
geom_point(data = df1 %>% filter(type != ">50% bacteria"),   # 只取 <=50% 的数据
size = 3,                           # 点大小 3
show.legend = F) +                  # 不显示图例
scale_x_discrete(position = "top",                          # x 轴放在顶部
limits = group$name %>% unique()) +        # x 轴顺序为 group 中的唯一 name
scale_y_discrete(limits = get_taxa_name(tree) %>% rev()) +  # y 轴顺序为树中叶节点名，反转
scale_color_manual(values = c("#55BF93", "#E9972A",         # 手动指定边框色
"#205FA7", "#DD5AA3",
"#F9CC13", "#91409A", "black")) +
labs(x = NULL, y = NULL) +                                  # 不显示轴标签
annotate("rect", xmin = -Inf, xmax = 14.5,                  # 添加矩形背景
ymin = -Inf, ymax = Inf,                           # 覆盖整个 y 范围
alpha = 0.2,                                       # 透明度 0.2
fill = "#55BF93") +                                # 填充色
annotate("rect", xmin = 14.5, xmax = 18.5,                  # 第 2 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#E9972A") +
annotate("rect", xmin = 18.5, xmax = 20.5,                  # 第 3 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#205FA7") +
annotate("rect", xmin = 20.5, xmax = 30.5,                  # 第 4 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#DD5AA3") +
annotate("rect", xmin = 30.5, xmax = 34.5,                  # 第 5 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#F9CC13") +
annotate("rect", xmin = 34.5, xmax = 43.5,                  # 第 6 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#91409A") +
annotate("rect", xmin = 43.5, xmax = Inf,                   # 第 7 个背景矩形
ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "black") +
theme_bw() +                                                # 黑白主题
theme(axis.text.x = element_text(angle = 90,                # x 轴文字旋转 90 度
color = "black",           # 文字颜色黑色
vjust = 0.5,               # 垂直对齐
hjust = 0),                # 水平对齐
axis.ticks = element_blank(),                         # 不显示刻度
axis.text.y = element_blank())                        # 不显示 y 轴文字
# ==================== 绘制图 plot2（柱状图） ====================
plot2 <- read_excel("41587_2023_1675_MOESM4_ESM.xlsx", sheet = 3) %>%   # 读取第 3 个工作表
pivot_longer(-Bacteria) %>%           # 宽转长
ggplot(aes(value, Bacteria,           # x 轴为 value，y 轴为 Bacteria
fill = name)) +            # 填充色按 name 映射
geom_col(show.legend = F,             # 柱状图，不显示图例
width = 0.8) +               # 柱宽 0.8
labs(x = NULL, y = NULL) +            # 不显示轴标签
scale_fill_manual(values = c("#006533", "black")) +   # 手动指定填充色
scale_y_discrete(limits = get_taxa_name(tree) %>% rev()) +  # y 轴顺序
scale_x_continuous(guide = "prism_offset_minor",      # x 轴用 Prism 风格次刻度
position = "top") +                # x 轴放在顶部
theme_prism() +                                        # Prism 主题
theme(axis.text.y = element_blank(),                   # 不显示 y 轴文字
axis.text.x = element_text(color = "black",      # x 轴文字黑色
size = 8),            # 字号 8
axis.line.y = element_blank(),                   # 不显示 y 轴线
axis.ticks.y = element_blank(),                  # 不显示 y 轴刻度
axis.ticks.x = element_line(size = 0.5),         # x 轴刻度线宽 0.5
axis.line.x = element_line(size = 0.5))          # x 轴线宽 0.5
# ==================== 组合三张图 ====================
plot <- (tree + plot2 + plot1) +                 # 用 patchwork 横向拼接三张图
plot_layout(widths = c(1, 0.5, 4))             # 宽度比例：1 : 0.5 : 4
# ==================== 图形注释 ====================
ggdraw(plot) +                                    # 用 cowplot 把拼接图转为可注释对象
draw_text(text = "Total number\nof pathways",   # 添加文字
size = 10,                            # 字号
x = 0.24, y = 0.68,                   # 位置（相对坐标 0-1）
color = "black") +                    # 颜色
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#55BF93",   # 添加色块
col = "#55BF93",     # 边框色
alpha = 0.2)),       # 透明度
x = 0.08, y = 0.81,                   # 位置
height = 0.03, width = 0.08) +        # 高度、宽度
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#E9972A", col = "#E9972A", alpha = 0.2)),
x = 0.08, y = 0.78, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#205FA7", col = "#205FA7", alpha = 0.2)),
x = 0.08, y = 0.75, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#DD5AA3", col = "#DD5AA3", alpha = 0.2)),
x = 0.08, y = 0.72, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#F9CC13", col = "#F9CC13", alpha = 0.2)),
x = 0.08, y = 0.69, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#91409A", col = "#91409A", alpha = 0.2)),
x = 0.08, y = 0.66, height = 0.03, width = 0.08) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "grey", col = "grey", alpha = 0.2)),
x = 0.08, y = 0.63, height = 0.03, width = 0.08) +
draw_text(text = "SCFA", size = 5, x = 0.12, y = 0.825, color = "black") +   # 注释文字. text 中size设置文字大小
draw_text(text = "SCFA-Others", size = 5, x = 0.12, y = 0.795, color = "black") +
draw_text(text = "Aliphatic amines", size = 5, x = 0.12, y = 0.765, color = "black") +
draw_text(text = "Aromatic", size = 5, x = 0.12, y = 0.735, color = "black") +
draw_text(text = "npAA", size = 5, x = 0.12, y = 0.705, color = "black") +
draw_text(text = "Other", size = 5, x = 0.12, y = 0.675, color = "black") +
draw_text(text = "Energy-MGCs", size = 5, x = 0.12, y = 0.645, color = "black") +
# 绘图图例框-1：>50% 和 <=50% 的图例
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),   # 白底黑框
x = 0.18, y = 0.81, height = 0.02, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.79, height = 0.02, width = 0.12) +
draw_line(x = c(0.2, 0.2), y = c(0.79, 0.83),   # 画竖线
size = 0.5, color = "black") +
draw_text(text = ">50% bacteria", size = 5, x = 0.255, y = 0.82, color = "black") +
draw_text(text = "<=50% bacteria", size = 5, x = 0.255, y = 0.8, color = "black") +
# 绘图图例框-2：Primary metabolism 和 Energy-MGCs 的图例
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.75, height = 0.02, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "white", col = "black")),
x = 0.18, y = 0.73, height = 0.02, width = 0.12) +
draw_line(x = c(0.2, 0.2), y = c(0.73, 0.77), size = 0.5, color = "black") +
draw_text(text = "Primary metabolism", size = 5, x = 0.254, y = 0.758, color = "black") +
draw_text(text = "Energy-MGCs", size = 5, x = 0.254, y = 0.738, color = "black") +
# 注释图例点：大圆点、小圆点、两个方块
draw_grob(grid::grid.circle(gp = grid::gpar(fill = "black", col = "black")),   # 大圆点
x = 0.13, y = 0.812, height = 0.016, width = 0.12) +
draw_grob(grid::grid.circle(gp = grid::gpar(fill = "black", col = "black")),   # 小圆点
x = 0.13, y = 0.792, height = 0.013, width = 0.12) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "#006533", col = "black")),   # 深绿色方块
x = 0.18, y = 0.75, height = 0.02, width = 0.02) +
draw_grob(grid::grid.rect(gp = grid::gpar(fill = "black", col = "black")),     # 黑色方块
x = 0.18, y = 0.73, height = 0.02, width = 0.02)
