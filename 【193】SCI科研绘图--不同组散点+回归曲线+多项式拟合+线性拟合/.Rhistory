#自定义颜色
col <- c("#ec1c24", "#fdbd10", "#0066b2", "#ed7902")  # 定义四种颜色
##绘图
ggplot(df, aes(x, y)) +       # 初始化 ggplot
#绘制基础散点图
geom_point(aes(fill = group), shape = 21, size = 5, alpha = 0.7) +  # 散点图，大小 5，透明度 0.7
#在X=6.25处添加辅助线进区分
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8) +  # 垂直分割线
# 对X<6.25的散点进行线性拟合
geom_smooth(data = df[df$x < 6.25, ],
method = "lm", color = "#84754e",   # 拟合线颜色
formula = y ~ x,
linetype = 1, alpha = 0.5, linewidth = 0.8) +
# 对X>6.25的散点进行线性拟合（实际是二次多项式）
geom_smooth(data = df[df$x > 6.25, ],
method = "lm", color = "#bc0024",   # 拟合线颜色
formula = y ~ poly(x, 2, raw = TRUE),
linetype = 1, alpha = 0.5, linewidth = 0.8) +
# 对X<6.25散点的线性拟合曲线添加回归方程
stat_poly_eq(data = df[df$x < 6.25, ],
formula = y ~ x,
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),
parse = TRUE, label.x = 0.05, label.y = 0.95,  # 标签位置
color = "#84754e") +   # 标签颜色与拟合线一致
# 对X>6.25散点的二次拟合曲线添加回归方程
stat_poly_eq(data = df[df$x < 6.25, ],   # 注意：这里写的是 df$x < 6.25，应该是笔误，本意可能是 df$x > 6.25
formula = y ~ poly(x, 2, raw = TRUE),
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),
parse = TRUE, label.x = 0.05, label.y = 0.9,
color = "#bc0024") +
#自定义颜色
scale_fill_manual(values = col) +   # 手动设置填充颜色
#对主题进行一些修改
theme_bw() +                        # 黑白主题
theme(axis.text = element_text(color = 'black', size = 14),   # 坐标轴文字
legend.text = element_text(color = 'black', size = 14), # 图例文字
axis.title = element_text(color = 'black', size = 15),  # 坐标轴标题
panel.grid = element_blank(),                           # 去掉网格线
legend.title = element_blank(),                         # 去掉图例标题
legend.position = c(0.9, 0.2)) +                        # 图例位置（右下角）
labs(x = "XXXXXXX", y = "XXXXXXX\n(XXXXXXXXXXXXX)", fill = NULL) +  # 设置轴标题
scale_x_continuous(expand = c(0, 0))   # x 轴不扩展
#保存图片
ggsave(filename = "不同组散点+回归曲线+多项式拟合+线性拟合.pdf", # 文件名及类型
width = 7,        # 宽 7 英寸
height = 6,       # 高 6 英寸
units = "in",     # 单位英寸
dpi = 300)        # 分辨率 300 dpi
rm(list=ls())                 # 清空当前环境中的所有对象，避免旧变量干扰
# setwd('')                   # 设置工作路径（被注释掉了，需要时取消注释并填入路径）
#加载R包
library(ggplot2)              # 加载 ggplot2，用于绘图
library(ggpmisc)              # 加载 ggpmisc，用于添加回归方程等扩展
#读取数据——以Chiplot绘图平台数据为例
df <- read.table("data.txt", sep = "\t", header = 1, check.names = FALSE)
# 从 data.txt 读取数据，制表符分隔，第一行为列名，不检查列名合法性
######绘图#######
#绘制基础散点图
ggplot(df, aes(x, y)) +       # 初始化 ggplot，x 轴为 x，y 轴为 y
geom_point(aes(fill = group), shape = 21, size = 3, alpha = 0.5)
# 绘制散点图：点形状为 21（可填充的圆），填充色按 group 区分，大小 3，透明度 0.5
##为了方便展示，在X=6.25处将图形分割成两部分，并对X<6.25和X>6.25的数据分别添加拟合曲线
#在X=6.25处添加辅助线进区分
ggplot(df, aes(x, y)) +       # 重新初始化 ggplot
geom_point(aes(fill = group), shape = 21, size = 3, alpha = 0.5) +  # 散点图
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8)
# 在 x = 6.25 处添加垂直虚线，线型 2（虚线），颜色 #08538c，线宽 0.8
#对X<6.25的散点进行线性拟合
ggplot(df, aes(x, y)) +       # 重新初始化 ggplot
geom_point(aes(fill = group), shape = 21, size = 3, alpha = 0.5) +  # 散点图
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8) +  # 垂直分割线
geom_smooth(data = df[df$x < 6.25, ],   # 只使用 x < 6.25 的数据子集
method = "lm",               # 使用线性模型拟合
color = "red",               # 拟合线颜色为红色
formula = y ~ x,             # 线性公式
linetype = 1, alpha = 0.5, linewidth = 0.8)
# 对 x < 6.25 的数据添加线性回归拟合线
#对X>6.25的散点进行二次拟合
ggplot(df, aes(x, y)) +       # 重新初始化 ggplot
geom_point(aes(fill = group), shape = 21, size = 3, alpha = 0.5) +  # 散点图
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8) +  # 垂直分割线
geom_smooth(data = df[df$x < 6.25, ],   # 注意：这里写的是 df$x < 6.25，应该是笔误，本意可能是 df$x > 6.25
method = "lm",               # 线性模型
color = "red",               # 红色
formula = y ~ x,             # 线性公式
linetype = 1, alpha = 0.5, linewidth = 0.8) +
# 对 x < 6.25 的数据再次添加线性拟合（与上一步重复）
geom_smooth(data = df[df$x > 6.25, ],   # 这里才是对 x > 6.25 的数据
method = "lm",               # 线性模型
color = "red",               # 红色
formula = y ~ poly(x, 2, raw = TRUE),  # 二次多项式拟合（原始多项式）
linetype = 1, alpha = 0.5, linewidth = 0.8)
# 对 x > 6.25 的数据添加二次多项式拟合线
#分别对两次拟合添加回归方程
ggplot(df, aes(x, y)) +       # 重新初始化 ggplot
geom_point(aes(fill = group), shape = 21, size = 3, alpha = 0.5) +  # 散点图
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8) +  # 垂直分割线
geom_smooth(data = df[df$x < 6.25, ],   # x < 6.25 的线性拟合
method = "lm", color = "red", formula = y ~ x,
linetype = 1, alpha = 0.5, linewidth = 0.8) +
geom_smooth(data = df[df$x > 6.25, ],   # x > 6.25 的二次拟合
method = "lm", color = "red", formula = y ~ poly(x, 2, raw = TRUE),
linetype = 1, alpha = 0.5, linewidth = 0.8) +
stat_poly_eq(data = df[df$x < 6.25, ],  # 对 x < 6.25 的数据添加回归方程
formula = y ~ x,           # 线性公式
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),  # 标签内容：方程 + 调整 R²，用 ~~~ 分隔
parse = TRUE, label.x = "left") +  # 解析为表达式，位置在左侧
stat_poly_eq(data = df[df$x < 6.25, ],  # 注意：这里写的是 df$x < 6.25，应该是笔误，本意可能是 df$x > 6.25
formula = y ~ poly(x, 2, raw = TRUE),  # 二次多项式公式
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),  # 标签内容
parse = TRUE, label.x = "right")
# 对 x < 6.25 的数据再次添加二次拟合方程（与上一步重复，且数据子集错误）
####个性化绘图模板
#自定义颜色
col <- c("#ec1c24", "#fdbd10", "#0066b2", "#ed7902")  # 定义四种颜色
##绘图
ggplot(df, aes(x, y)) +       # 初始化 ggplot
#绘制基础散点图
geom_point(aes(fill = group), shape = 21, size = 5, alpha = 0.7) +  # 散点图，大小 5，透明度 0.7
#在X=6.25处添加辅助线进区分
geom_vline(xintercept = 6.25, linetype = 2, color = "#08538c", linewidth = 0.8) +  # 垂直分割线
# 对X<6.25的散点进行线性拟合
geom_smooth(data = df[df$x < 6.25, ],
method = "lm", color = "#84754e",   # 拟合线颜色
formula = y ~ x,
linetype = 1, alpha = 0.5, linewidth = 0.8) +
# 对X>6.25的散点进行线性拟合（实际是二次多项式）
geom_smooth(data = df[df$x > 6.25, ],
method = "lm", color = "#bc0024",   # 拟合线颜色
formula = y ~ poly(x, 2, raw = TRUE),
linetype = 1, alpha = 0.5, linewidth = 0.8) +
# 对X<6.25散点的线性拟合曲线添加回归方程
stat_poly_eq(data = df[df$x < 6.25, ],
formula = y ~ x,
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),
parse = TRUE, label.x = 0.05, label.y = 0.95,  # 标签位置
color = "#84754e") +   # 标签颜色与拟合线一致
# 对X>6.25散点的二次拟合曲线添加回归方程
stat_poly_eq(data = df[df$x > 6.25, ],   # 注意：这里写的是 df$x < 6.25，应该是笔误，本意可能是 df$x > 6.25
formula = y ~ poly(x, 2, raw = TRUE),
aes(label = paste(after_stat(eq.label),
after_stat(adj.rr.label),
sep = "~~~")),
parse = TRUE, label.x = 0.05, label.y = 0.9,
color = "#bc0024") +
#自定义颜色
scale_fill_manual(values = col) +   # 手动设置填充颜色
#对主题进行一些修改
theme_bw() +                        # 黑白主题
theme(axis.text = element_text(color = 'black', size = 14),   # 坐标轴文字
legend.text = element_text(color = 'black', size = 14), # 图例文字
axis.title = element_text(color = 'black', size = 15),  # 坐标轴标题
panel.grid = element_blank(),                           # 去掉网格线
legend.title = element_blank(),                         # 去掉图例标题
legend.position = c(0.9, 0.2)) +                        # 图例位置（右下角）
labs(x = "XXXXXXX", y = "XXXXXXX\n(XXXXXXXXXXXXX)", fill = NULL) +  # 设置轴标题
scale_x_continuous(expand = c(0, 0))   # x 轴不扩展
#保存图片
ggsave(filename = "不同组散点+回归曲线+多项式拟合+线性拟合.pdf", # 文件名及类型
width = 7,        # 宽 7 英寸
height = 6,       # 高 6 英寸
units = "in",     # 单位英寸
dpi = 300)        # 分辨率 300 dpi
