library(patchwork)
df <- iris %>% pivot_longer(-Species) %>%
group_by(Species) %>%
slice_head(n=2) %>%
ungroup() %>%
slice(-4,-6)
p1 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position =  "dodge")
p2 <- ggplot(mtcars, aes(factor(cyl), fill = factor(vs))) +
geom_bar(position = position_dodge(preserve = "single"))
p3 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))
p1+p2+p3
p3 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))+
theme(legend.position ="non")
p1 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position =  "dodge")+
theme(legend.position ="non")
p2 <- ggplot(mtcars, aes(factor(cyl), fill = factor(vs))) +
geom_bar(position = position_dodge(preserve = "single"))+
theme(legend.position ="non")
p3 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))+
theme(legend.position ="non")
p1+p2+p3
p3 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))+
labs(x=NULL,y=NULL)+
theme(legend.position ="non")
p1 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position =  "dodge")+
labs(x=NULL,y=NULL)+
theme(legend.position ="non")
p2 <- ggplot(mtcars, aes(factor(cyl), fill = factor(vs))) +
geom_bar(position = position_dodge(preserve = "single"))+
labs(x=NULL,y=NULL)+
theme(legend.position ="non")
p3 <- ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))+
labs(x=NULL,y=NULL)+
theme(legend.position ="non")
p1+p2+p3
