library(tidyverse)
df <- iris %>% pivot_longer(-Species) %>%
group_by(Species) %>%
slice_head(n=2) %>%
ungroup() %>%
slice(-4,-6)
ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position =  "dodge")
ggplot(mtcars, aes(factor(cyl), fill = factor(vs))) +
geom_bar(position = position_dodge(preserve = "single"))
ggplot(df) +
geom_col(aes(x =Species,y=value,fill=name),
position = position_dodge2(preserve = "single"))
set.seed(2967358)                                          # Create example data
data <- data.frame(values = rnorm(100),
group = LETTERS[1:4])
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_summary(fun = mean, geom = "point", col = "red") +  # Add points to plot
stat_summary(fun = mean, geom = "text", col = "red",     # Add text to plot
vjust = 1.5, aes(label = paste("Mean:", round(..y.., digits = 1))))
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_summary(fun = mean, geom = "point", col = "red") +  # Add points to plot
stat_summary(fun = mean, geom = "text", col = "red",     # Add text to plot
vjust = 1.5, aes(label = paste("Mean:", round(..y.., digits = 1))))+
stat_summary(fun.data = "mean_cl_normal", geom = "errorbar", width = .2, color="#00A08A")
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_summary(fun = mean, geom = "point", col = "red") +  # Add points to plot
stat_summary(fun = mean, geom = "text", col = "red",     # Add text to plot
vjust = 1.5, aes(label = paste("Mean:", round(..y.., digits = 1))))+
stat_summary(geom = "errorbar", width = .2, color="#00A08A")
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_boxplot(geom="errorbar")
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_boxplot(geom="errorbar",width=0.2)+
stat_summary(fun = mean, geom = "point", col = "red") +  # Add points to plot
stat_summary(fun = mean, geom = "text", col = "red",     # Add text to plot
vjust = 1.5, aes(label = paste("Mean:", round(..y.., digits = 1))))
ggplot(data, aes(x = group, y = values)) +                 # Draw ggplot2 boxplot
geom_boxplot() +
stat_boxplot(geom="errorbar",width=0.1)+
