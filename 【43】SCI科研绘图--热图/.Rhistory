# data：数据
layer(data = data,                       # 指定数据
stat = StatIdentity,               # 不进行统计变换
position = PositionIdentity,       # 不进行位置调整
geom = ggplot2:::GeomCustomAnn,    # 使用自定义注释几何对象
inherit.aes = TRUE,                # 继承美学映射
params = list(grob = grob,         # 参数：图形对象
xmin = xmin, xmax = xmax,
ymin = ymin, ymax = ymax))
}
