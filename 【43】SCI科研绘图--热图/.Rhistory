pull() %>%
rev())                   # 反转
df2$group <- factor(df2$group,             # group 转因子
levels = df2$group %>% # 水平顺序
as.data.frame() %>%
distinct() %>%
pull())
df2$name <- factor(df2$name,               # name 转因子
levels = df2$name %>%   # 水平顺序
as.data.frame() %>%
distinct() %>%
pull())
# ==================== 自定义注释函数 ====================
annotation_custom2 <- function(grob, xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf, data) {
# grob：要绘制的图形对象
# xmin/xmax/ymin/ymax：位置范围
# data：数据
layer(data = data,                       # 指定数据
stat = StatIdentity,               # 不进行统计变换
position = PositionIdentity,       # 不进行位置调整
geom = ggplot2:::GeomCustomAnn,    # 使用自定义注释几何对象
inherit.aes = TRUE,                # 继承美学映射
params = list(grob = grob,         # 参数：图形对象
xmin = xmin, xmax = xmax,
ymin = ymin, ymax = ymax))
}
# ==================== 自定义分面条样式 ====================
ridiculous_strips <- strip_themed(
text_y = elem_list_text(                 # 分面文字样式
colour = c("#FCFAD9", "#EDB749", "#3CB2EC", "#12618D", "#9C8D58", "#4A452A"),  # 文字颜色
face = c("bold", "bold", "bold", "plain", "bold", "bold"),  # 字体样式
size = c(12, 12, 12, 12, 12, 12)       # 字号
),
background_y = elem_list_rect(           # 分面背景样式
fill = c("#FCFAD9", "#FFF2E7", "#E8F2FC", "#BDE7FF", "#EEECE1", "#DDD9C3")  # 背景色
)
)
# ==================== 自定义各分面的坐标轴颜色 ====================
scales <- list(
scale_y_discrete(guide = guide_axis_colour(colour = rev(c("#EDB749", "#3CB2EC", "#9C8D58"))), expand = c(0, 0)),
# 第 1 个分面：y 轴文字颜色
scale_y_discrete(guide = guide_axis_colour(colour = "#EDB749"), expand = c(0, 0)),
# 第 2 个分面
scale_y_discrete(guide = guide_axis_colour(colour = "#3CB2EC"), expand = c(0, 0)),
# 第 3 个分面
scale_y_discrete(guide = guide_axis_colour(colour = "#12618D"), expand = c(0, 0)),
# 第 4 个分面
scale_y_discrete(guide = guide_axis_colour(colour = "#9C8D58"), expand = c(0, 0)),
# 第 5 个分面
scale_y_discrete(guide = guide_axis_colour(colour = "#4A452A"), expand = c(0, 0))
# 第 6 个分面
)
# ==================== 绘制图形 ====================
df2 %>% ggplot(., aes(name, ID, col = Rvalue, fill = Rvalue)) +
# x=name，y=ID，颜色和填充按 Rvalue 映射
# ---- 白色底块 ----
geom_tile(color = "grey80",              # 边框色灰色
fill = "white",                # 填充白色
size = 0.1) +                  # 边框线宽 0.1
# ---- 彩色方块（按 R 值着色） ----
geom_point(aes(size = abs(Rvalue)),      # 大小按 R 值绝对值
shape = 22) +                 # 形状：22 是方形
# ---- 显著性符号 ----
geom_text(aes(label = p_signif),         # 标签为显著性符号
size = 4,                      # 字号 4
color = "white",               # 白色
hjust = 0.5, vjust = 0.7) +    # 居中对齐
# ---- 自定义分面 ----
facet_grid2(vars(group),                 # 按 group 分面
scale = "free_y",            # y 轴各分面独立
switch = "y",                # 分面标签放在 y 轴一侧
strip = ridiculous_strips) + # 使用自定义分面样式
# ---- 强制分面大小 ----
force_panelsizes(cols = c(2.8),          # 列宽
rows = c(1, 4, 1, 1, 1.2, 1),  # 各行高度
respect = TRUE) +       # 保持比例
# ---- 标签 ----
labs(x = NULL, y = NULL, color = NULL, fill = NULL) +
# ---- 颜色渐变 ----
scale_color_gradientn(colours = RColorBrewer::brewer.pal(11, "RdBu")) +   # 颜色渐变
scale_fill_gradientn(colours = RColorBrewer::brewer.pal(11, "RdBu")) +    # 填充渐变
# ---- y 轴设置 ----
scale_y_discrete(expand = c(0, 0),       # 不留空白
position = 'left') +    # y 轴在左侧
# ---- x 轴设置 ----
scale_x_discrete(expand = c(0, 0),       # 不留空白
position = 'top',       # x 轴在顶部
labels = c("HR" = expression(R[h]),   # x 轴标签：HR → R_h
"SR" = expression(R[s])))  # SR → R_s
# ---- 主题设置 ----
theme(
axis.text.x = element_text(angle = 45,  # x 轴文字旋转 45 度
hjust = 0,   # 水平对齐
vjust = 1,   # 垂直对齐
color = c(rep("#3CB2EC", 4), rep("#EDB749", 5)),  # 文字颜色
face = "bold",  # 粗体
size = 10),     # 字号
axis.text.y = element_text(face = "bold", size = 10),  # y 轴文字
axis.ticks = element_blank(),           # 不显示刻度
panel.grid.minor = element_blank(),     # 不显示次网格线
panel.grid.major = element_blank(),     # 不显示主网格线
strip.placement = 'outside',            # 分面标签放在轴外侧
panel.background = element_blank(),     # 面板背景透明
strip.text.y = element_text(size = 10,  # 分面文字：字号 10
color = "black",  # 黑色
face = "bold"),   # 粗体
panel.spacing.y = unit(0, "cm")         # 分面间距 0
) +
# ---- 各分面独立坐标轴 ----
facetted_pos_scales(y = scales) +        # 应用自定义坐标轴
# ---- 图例设置 ----
scale_size(guide = NULL) +               # 不显示大小图例
guides(color = guide_colorbar(direction = "vertical",  # 颜色图例垂直
reverse = F,             # 不反转
barwidth = unit(.5, "cm"),   # 图例条宽
barheight = unit(20.45, "cm"))) +  # 图例条高
# ---- 允许元素超出绘图区域 ----
coord_cartesian(clip = 'off') +
# ---- 背景注释矩形（各分面背景色） ----
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#DDD9C3", col = "#DDD9C3")),  # 矩形
data = df2 %>% filter(group == "Protistan\ntrophic\ngroups"),   # 数据
xmin = -7.5, xmax = 0.38, ymin = 0.54, ymax = 3.5) +            # 位置
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#EEECE1", col = "#EEECE1")),
data = df2 %>% filter(group == "Protistan\nlineages"),
xmin = -7.5, xmax = 0.38, ymin = 0.54, ymax = 5.5) +
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#E8F2FC", col = "#E8F2FC")),
data = df2 %>% filter(group == "Fungal\nphyla"),
xmin = -7.5, xmax = 0.38, ymin = 0.53, ymax = 3.5) +
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#BDE7FF", col = "#BDE7FF")),
data = df2 %>% filter(group == "Fungal\nguilds"),
xmin = -7.5, xmax = 0.38, ymin = 0.53, ymax = 3.5) +
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#FFF2E7", col = "#FFF2E7")),
data = df2 %>% filter(group == "Baclerial phyla"),
xmin = -7.5, xmax = 0.38, ymin = 0.53, ymax = 14.5) +
annotation_custom2(
grob = rectGrob(gp = gpar(fill = "#FCFAD9", col = "#FCFAD9")),
data = df2 %>% filter(group == " "),
xmin = -7.5, xmax = 0.38, ymin = 0.53, ymax = 3.5)
# ==================== 加载所需的包 ====================
library(tidyverse)   # 数据处理和绘图（含 dplyr、tidyr、ggplot2、readr 等）
library(magrittr)    # 提供管道操作符
library(ggh4x)       # 提供 facet_grid2()、strip_themed() 等扩展分面功能
library(grid)
# ==================== 读取并整理数据 ====================
df <- read_tsv("R.xls") %>%               # 读取 R 值数据
pivot_longer(-ID) %>%                   # 宽转长：除 ID 外的列变成长表
left_join(.,                            # 左连接：合并 p 值数据
read_tsv("p.xls") %>% pivot_longer(-ID),   # 读取 p 值数据并宽转长
by = c("ID", "name")) %>%     # 按 ID 和 name 连接
set_colnames(c("ID", "name", "Rvalue", "Pvalue")) %>%   # 重命名列
mutate(p_signif = symnum(Pvalue,        # 根据 P 值生成显著性符号
corr = FALSE,  # 不校正
na = FALSE,    # 不处理 NA
cutpoints = c(0, 0.001, 0.01, 0.05, 0.1, 1),   # p 值阈值
symbols = c("***", "**", "*", ".", " ")))      # 对应符号
# ==================== 创建分组信息 ====================
group <- df %>%
select(1) %>%                           # 只取第 1 列（ID）
distinct() %>%                          # 去重
as.data.frame() %>%                     # 转为数据框
rownames_to_column("raw") %>%           # 行名转为 raw 列
mutate(
raw = as.numeric(raw),                # raw 转数值
group = case_when(
raw > 3 & raw <= 17 ~ "Baclerial phyla",       # 第 4-17 行：细菌门
raw <= 3 ~ " ",                                 # 第 1-3 行：空
raw > 17 & raw <= 20 ~ "Fungal\nphyla",         # 第 18-20 行：真菌门
raw > 20 & raw <= 23 ~ "Fungal\nguilds",        # 第 21-23 行：真菌功能群
raw > 23 & raw <= 28 ~ "Protistan\nlineages",   # 第 24-28 行：原生生物谱系
raw > 28 ~ "Protistan\ntrophic\ngroups"         # 第 29 行以后：原生生物营养群
)
) %>%
select(-raw)                            # 删除 raw 列
# ==================== 数据整理与重命名 ====================
df2 <- df %>%
left_join(., group, by = "ID") %>%      # 关联分组信息
mutate(
across("ID", str_replace, "total", "richness"),   # ID 中 "total" 替换为 "richness"
across("name", str_replace, "Total.biomass", "Microbial"),  # name 中替换
across("name", str_replace, ".biomass", ""),       # 去掉 ".biomass"
across("name", str_replace, "F.B.ratio", "F:B ratio")  # 替换
)
# ==================== 固定因子顺序 ====================
df2$ID <- factor(df2$ID,                   # ID 转因子
levels = df2$ID %>%       # 水平顺序
as.data.frame() %>%
distinct() %>%
pull() %>%
rev())                   # 反转
df2$group <- factor(df2$group,             # group 转因子
levels = df2$group %>% # 水平顺序
as.data.frame() %>%
distinct() %>%
pull())
df2$name <- factor(df2$name,               # name 转因子
levels = df2$name %>%   # 水平顺序
as.data.frame() %>%
distinct() %>%
pull())
# ==================== 自定义注释函数 ====================
