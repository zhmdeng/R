# ---- 颜色渐变 ----
scale_color_gradientn(colours = RColorBrewer::brewer.pal(11, "RdBu")) +   # 颜色渐变
scale_fill_gradientn(colours = RColorBrewer::brewer.pal(11, "RdBu")) +    # 填充渐变
# ---- y 轴设置 ----
scale_y_discrete(expand = c(0, 0),       # 不留空白
position = 'left') +    # y 轴在左侧
# ---- x 轴设置 ----
scale_x_discrete(expand = c(0, 0),       # 不留空白
position = 'top',       # x 轴在顶部
labels = c("HR" = expression(R[h]),   # x 轴标签：HR → R_h
"SR" = expression(R[s])))  # SR → R_s
# ---- 主题设置 ----
theme(
axis.text.x = element_text(angle = 45,  # x 轴文字旋转 45 度
