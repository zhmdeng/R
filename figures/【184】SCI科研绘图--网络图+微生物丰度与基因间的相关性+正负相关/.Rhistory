#      vertex.color = ifelse(V(graph)$group == "Mic", "red", "blue"))  # Mic 红色，Gene 蓝色
# 第二张图：圆形布局
plot(graph,
layout = layout_in_circle(graph),  # 圆形布局
vertex.size = 5,
vertex.label = NA,
vertex.color = ifelse(V(graph)$group == "Mic", "red", "blue"))
dev.off()   # 关闭 PDF 设备
