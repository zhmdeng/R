as_tibble() %>%                  # 转为 tibble
group_by(value) %>%              # 按节点名分组
summarise()                      # 去重，得到唯一节点名
colnames(vertices) <- "name"       # 列名改为 name
vertices <- vertices %>%
left_join(group, by = "name")    # 关联分组信息（Mic/Gene）
