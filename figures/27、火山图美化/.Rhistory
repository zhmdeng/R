########做图文件########
library(ggpubr)
# 读取数据
pic <- read.csv("做图文件.csv", row.names = 1)
# 绘制箱式图并添加p值
p <- ggboxplot(
pic,
x = "group",
y = "TIDE",
color = "group",
palette = c("#00AFBB", "#E7B800"),
add = "jitter",
shape = "group"
)
# 添加p值比较并显示具体p值
p + stat_compare_means(method = "t.test",
label = "p.format",
label.y = max(pic$TIDE) * 1.1)
ggsave("结果.png",dpi = 300)
ggsave("结果.pdf",width = 8,height = 8)
