guides(fill = guide_legend(ncol = 2))
# 在原有属水平绘图代码基础上修改配色部分：
# 定义SCI配色方案（提取前6个有效颜色）
sci_colors <- c(
"#F66F69",  # R:246 G:111 B:105
"#1597A5",  # R:21  G:151 B:165
"#FFC24B",  # R:255 G:194 B:75
"#0E606B",  # R:14  G:96  B:107
"#FEB3AE",  # R:254 G:179 B:174
"#FFF4F2"   # R:255 G:244 B:242
)
# 绘制堆叠柱状图（修改scale_fill部分）
ggplot(long_data, aes(x = Sample, y = Total, fill = Genus)) +
geom_col(position = "stack", color = "black", linewidth = 0.2) +
labs(
title = "微生物群落组成（属水平）",
x = "样本",
y = "序列丰度",
fill = "属分类"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.text = element_text(size = 8)
) +
scale_fill_manual(
values = colorRampPalette(sci_colors)(length(unique(long_data$Genus)) # 颜色扩展
) +
guides(fill = guide_legend(ncol = 2))  # 分两列显示图例
# 保存高清图
ggsave("genus_abundance_sci_style.png", width = 14, height = 8, dpi = 300)
