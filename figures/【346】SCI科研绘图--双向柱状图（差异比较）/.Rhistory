geom_text(data = data[which(data$value < 0), ], aes(x = pathway, y = 0, label = pathway),
hjust = -0.1, size = 2) +
# 添加value的label：
geom_text(data = data[which(data$value >= 0), ], aes(x = pathway, y = value, label = value),
hjust = -0.2, size = 2, color = "black") +
geom_text(data = data[which(data$value < 0), ], aes(x = pathway, y = value, label = value),
hjust = 1.2, size = 2, color = "black") +
