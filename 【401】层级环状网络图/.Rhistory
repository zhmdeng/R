grepl("^group", Level) ~ "bold",
grepl("^period", Level) ~ "bold",
TRUE ~ "plain"
),
# 设置文字向外偏移量（越外围的 sample 需要更大偏移）
text_offset = ifelse(grepl("^sample", Level), 1.18, 1.12)
)
# ========== 第六步：绘图 ==========
p <- ggraph(df_graph, layout = 'dendrogram', circular = TRUE) +  # 以树状图+圆形布局
# --- 1. 绘制边（线） ---
geom_edge_diagonal(aes(color = linecolor), linewidth = 0.6, show.legend = FALSE) +
# 设置边的颜色（黄 蓝 绿）
scale_edge_color_manual(values = c("c1" = "#ffb900", "c2" = "#1aafd0", "c3" = "#3be8b0")) +
# --- 2. 绘制节点（圆点） ---
geom_node_point(aes(color = group, size = size), show.legend = FALSE) +
# 设置节点颜色（groupA 黄，groupB 蓝，groupC 绿，中心红）
scale_color_manual(values = c("g1" = "#ffb900", "g2" = "#1aafd0", "g3" = "#3be8b0", "g4" = "#fc636b")) +
