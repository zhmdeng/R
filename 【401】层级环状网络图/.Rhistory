# ========== 载入所需的R包 ==========
library(ggplot2)      # 画图主力库
library(dplyr)        # 数据整理
library(tidyr)        # 数据转换
library(ggraph)       # 复杂网络绘图
library(tidygraph)    # 网络图数据结构处理
library(reshape2)     # 用于 melt 函数
library(ggnewscale)   # 支持多次使用 scale 系列函数（非必须）
# ========== 第一步：读取原始数据 ==========
setwd("/Users/mac/Desktop/PowerBI/sci科研绘图/【401】层级环状网络图/")
df <- read.table("data.txt",
sep = "\t", header = TRUE, check.names = FALSE)
# ========== 第二步：构造节点数据（用于绘图节点大小和分层结构） ==========
df_node <- data.frame()
# 遍历每一列（除了最后一列Value），统计每层每个节点的出现总值
for (i in 1:(length(df) - 1)) {
group <- colnames(df)[i]
data <- df[c(i, 5)] %>%
group_by(Level = !!sym(group)) %>%
summarise(size = sum(Value), level = i, .groups = 'drop')  # 统计每个节点的 size
df_node <- bind_rows(df_node, data)  # 合并进主数据框
}
# ========== 第三步：添加每个节点的 group 分组信息 ==========
df2 <- df[1:4]  # 取前4列的层级
df2$group <- ifelse(df2$Level2 == "groupA", "g1",
ifelse(df2$Level2 == "groupB", "g2", "g3"))  # 分配 g1/g2/g3
# 构造映射：每个Level对应一个group
df3 <- unique(melt(df2, id.vars = "group")[, c(1, 3)])  # 拍平后取 group-Level 对
df3$group[df3$value == "Network"] <- "g4"  # 特殊处理中心节点
colnames(df3)[2] <- "Level"
df_node <- merge(df_node, unique(df3), by = "Level")  # 加入 group 信息
# ========== 第四步：构造边数据（用于连接父子节点） ==========
df_edge <- data.frame()
for (i in 1:(ncol(df) - 2)) {
tmp <- df[, c(i, i + 1)]  # 从第i列连接到第i+1列
colnames(tmp) <- c("from", "to")
df_edge <- rbind(df_edge, tmp)
}
df_edge <- unique(df_edge)  # 去重
# 为每条边分配颜色类别（c1:黄，c2:蓝，c3:绿）
df_edge$linecolor <- ifelse(grepl("groupA", df_edge$from), "c1",
ifelse(grepl("groupB", df_edge$from), "c2", "c3"))
# ========== 第五步：构造图对象，设置每个节点的样式 ==========
df_graph <- tbl_graph(nodes = df_node, edges = df_edge, directed = TRUE) %>%
activate(nodes) %>%
mutate(
# 设置节点文字大小（中心最大，sample最小）
font_size = case_when(
Level == "Network" ~ 4.5,
grepl("^group", Level) ~ 3.5,
grepl("^period", Level) ~ 2.8,
TRUE ~ 2.0
),
# 设置文字是否加粗
fontface = case_when(
Level == "Network" ~ "bold",
grepl("^group", Level) ~ "bold",
grepl("^period", Level) ~ "bold",
TRUE ~ "plain"
),
# 设置文字向外偏移量（越外围的 sample 需要更大偏移）
text_offset = ifelse(grepl("^sample", Level), 1.18, 1.12)
)
# ========== 第六步：绘图 ==========
p <- ggraph(df_graph, layout = 'dendrogram', circular = TRUE) +  # 以树状图+圆形布局
# --- 1. 绘制边（线） ---
geom_edge_diagonal(aes(color = linecolor), linewidth = 0.6, show.legend = FALSE) +
# 设置边的颜色（黄 蓝 绿）
scale_edge_color_manual(values = c("c1" = "#ffb900", "c2" = "#1aafd0", "c3" = "#3be8b0")) +
# --- 2. 绘制节点（圆点） ---
geom_node_point(aes(color = group, size = size), show.legend = FALSE) +
# 设置节点颜色（groupA 黄，groupB 蓝，groupC 绿，中心红）
scale_color_manual(values = c("g1" = "#ffb900", "g2" = "#1aafd0", "g3" = "#3be8b0", "g4" = "#fc636b")) +
coord_fixed() +  # 固定横纵比，避免变形
# --- 3. 绘制文字标签 ---
geom_node_text(
aes(
x = text_offset * x,  # 控制偏移，让 sample 标签朝外
y = text_offset * y,
label = Level,
angle = ifelse(
grepl("^sample", Level),
atan2(y, x) * 180 / pi,  # 保证 sample 标签方向朝外（不旋转180）
0  # group、period、中心等文字保持水平
),
size = font_size,     # 字号大小
fontface = fontface   # 字体样式（是否加粗）
),
color = "black", family = "serif", show.legend = FALSE  # 黑色文字，衬线体，无图例
) +
# --- 4. 其它样式调整 ---
scale_size_identity() +                    # 使用原始 size 值
scale_size_continuous(range = c(2, 28)) +  # 控制节点大小范围
theme_void()                               # 空白背景，去除坐标轴等
# ========== 第七步：保存图片 ==========
ggsave("D:/network_tree_final.png", p, width = 8, height = 8, dpi = 300, bg = "white")
