bb$Cell.types <- as.character(bb$Cell.types)   # 细胞类型转为字符型
colnames(bb)[1] <- c("ID")      # 将第一列改名为 ID
bb$weight <- abs(log10(bb$log_rank_p))         # 计算权重：log-rank P 值的绝对值对数
bb$weight_HR <- (as.numeric(bb$HR) - 1) * 100  # HR 转数值并映射到颜色
bb$colr <- ifelse(bb$weight_HR < 0, "green", "black")  # HR<0 绿色，否则黑色
# 保存生存分析数据到文件（后续可能用于颜色标注）
write.csv(bb, "output_HR_corlor.csv", quote = F)
# 计算 Spearman 相关系数矩阵
corr <- cor(input_data, method = "spearman")
# 绘制相关性矩阵图（饼图形式）
corrplot(corr, title = "",
method = "pie",                # 用饼图表示相关系数
outline = T, addgrid.col = "darkgray",   # 外框和网格线颜色
order = "hclust", addrect = 4, # 层次聚类排序，并画 4 个矩形框
mar = c(4, 0, 4, 0),           # 边距，让标签显示完整
rect.col = "black", rect.lwd = 5, cl.pos = "b",  # 矩形框样式
tl.col = "black", tl.cex = 0.8, cl.cex = 0.8, tl.srt = 60)  # 标签颜色、大小、旋转角度
# 自定义函数：计算相关系数矩阵的 p 值矩阵
cor.mtest <- function(corr, ...) {
corr <- as.matrix(corr)           # 确保输入是矩阵
n <- ncol(corr)                   # 变量个数
p.corr <- matrix(NA, n, n)        # 初始化 p 值矩阵
diag(p.corr) <- 0                 # 对角线 p 值为 0
for (i in 1:(n - 1)) {            # 遍历上三角
for (j in (i + 1):n) {
# 注意：下面这行 cor.test 的参数顺序有误，正确应为 cor.test(corr[, i], corr[, j], method = "spearman", ...)
tmp <- cor.test(corr[, i], method = "spearman", corr[, j], ...)
p.corr[i, j] <- p.corr[j, i] <- tmp$p.value   # 对称填充 p 值
}
}
colnames(p.corr) <- rownames(p.corr) <- colnames(corr)  # 设置行列名
p.corr                           # 返回 p 值矩阵
}
p.corr <- cor.mtest(input_data)     # 计算 p 值矩阵
head(p.corr[, 1:5])                 # 查看部分 p 值
# 将相关系数矩阵转为长格式
rr <- as.data.frame(corr)
rr$ID <- rownames(rr)               # 添加行名作为 ID 列
cor <- melt(rr, "ID", value.name = "cor")   # 转为长格式，列：ID, variable, cor
# 将 p 值矩阵转为长格式
pp <- as.data.frame(p.corr)
pp$ID <- rownames(pp)
pvalue <- melt(pp, "ID", value.name = "pvalue")  # 列：ID, variable, pvalue
colnames(pvalue) <- c("from", "to", "pvalue")    # 重命名列
corpvlue <- cbind(pvalue, cor)       # 合并 p 值和相关系数
head(corpvlue)
corpvlue <- corpvlue[, -c(4:5)]      # 删除重复的 ID 和 variable 列
head(corpvlue)
dim(corpvlue)                        # 查看维度
# 只保留 p 值小于 0.0001 的强相关
corpvlue <- corpvlue[corpvlue$pvalue < 0.0001, ]
dim(corpvlue)
# 计算权重：-log10(p)
corpvlue$weight <- corpvlue$pvalue
corpvlue$weight <- -log10(corpvlue$weight)
head(corpvlue)
# 去掉相关系数为 1 的自身相关
corpvlue <- corpvlue[!corpvlue$cor == 1, ]
dim(corpvlue)
# 去掉重复的边：按 weight 去重（这里逻辑有风险，可能误删不同变量对）
summary(duplicated(corpvlue$weight))
corpvlue <- corpvlue[!duplicated(corpvlue$weight), ]
dim(corpvlue)
# 根据相关系数正负设置边的颜色
corpvlue$color <- ifelse(corpvlue$cor < 0, negcol, poscol)
# 保存清理后的边数据
write.csv(corpvlue, "output.csv")
# 转置表达矩阵，用于聚类
cellcluster <- as.data.frame(t(input_data))
# 对细胞进行层次聚类
hc <- hclust(dist((cellcluster)))
hcd <- as.dendrogram(hc)
(clus4 <- cutree(hc, 4))            # 切分为 4 类
# 提取每个类的细胞名称
A <- as.character(rownames(as.data.frame(subset(clus4, clus4 == 1))))
B <- as.character(rownames(as.data.frame(subset(clus4, clus4 == 2))))
C <- as.character(rownames(as.data.frame(subset(clus4, clus4 == 3))))
D <- as.character(rownames(as.data.frame(subset(clus4, clus4 == 4))))
cls <- list(A, B, C, D)
# 构建节点数据框
nodes <- as.data.frame(unlist(cls))
nodes$type <- c(rep("B", 9), rep("A", 4), rep("C", 5), rep("D", 5))  # 按类大小分配标签
names(nodes) <- c("media", "type.label")   # 重命名列
# 手动调整部分细胞的类别标签
nodes$type.label[nodes$media == "T cells follicular helper"] <- "B"
nodes$type.label[nodes$media == "B cells naive"] <- "A"
nodes$type.label[nodes$media == "T cells CD4 naive"] <- "A"
nodes$type.label[nodes$media == "Plasma cells"] <- "A"
nodes$type.label[nodes$media == "Dendritic cells resting"] <- "C"
nodes$type.label[nodes$media == "Eosinophils"] <- "C"
nodes$type.label[nodes$media == "Mast cells resting"] <- "A"
nodes <- as.data.frame(nodes)
nodes$media <- as.character(nodes$media)
nodes
# 检查节点细胞名是否与生存数据匹配
summary(nodes$media %in% bb$ID)
# 合并节点数据和生存数据（注意：by.x 和 by.y 写法有误）
nodes <- merge(nodes, bb, by.x = "media", "ID", all.x = T, all.y = T)  # 错误写法，应为 by.y = "ID"
# 计算节点大小和 id
nodes$Fraction <- abs(nodes$weight_HR)
nodes$id <- paste("S", 01:23, sep = "")   # 错误：不会补零，应使用 sprintf("S%02d", 1:23)
# 按 type.label 排序，并调整列顺序（索引有误）
nodes <- nodes[order(nodes$type.label), ]
nodes <- nodes[, c(ncol(nodes), 1:ncol(nodes) - 1)]   # 错误：1:ncol(nodes)-1 包含 0
nodes <- nodes[order(nodes$type.label), ]
nodes
# 把细胞名替换为节点 ID（用 revalue 进行映射）
corpvlue$from <- revalue(corpvlue$from, c('B cells memory'='S1', 'B cells naive'='S2', ...))  # 省略，实际代码有完整映射
