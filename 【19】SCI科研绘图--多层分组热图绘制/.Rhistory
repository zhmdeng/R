p2 <- Fig1a.function.pca %>%
insert_top(Fig1a.function.pc1.density,height = 0.3) %>%
insert_right(Fig1a.function.pc2.density,width=0.3) %>%
as.ggplot()
(p1|p2)+plot_layout(ncol=2,width = c(0.8,1))
