library(tidyverse)
library(introdataviz)
BiocManager::install("introdataviz")
library(introdataviz)
devtools::install_github("psyteachr/introdataviz")
library(introdataviz)
library(ggpubr)
library(ggsci)
library(ggprism)
library(scales)
library(patchwork)
dd2 <- read_tsv("F6.txt") %>% pivot_longer(- lncRNA_signature)
colors = c("#5a72b5","#ea5a49")
a <- ggplot(dd2,aes(x = name, y = value,fill= lncRNA_signature))+
geom_split_violin(trim =F,color = NA,adjust = 1.5)+
guides(fill=guide_legend(title="group"))+
scale_fill_manual(values = colors)+
stat_summary(fun.data = "mean_sd",position=position_dodge(0.15),geom = "errorbar",width = .1) +
stat_summary(fun = "mean", geom = "point", position=position_dodge(0.15),show.legend = F)+
stat_compare_means(aes(group = lncRNA_signature), label = "p.signif",label.y=12, method="t.test")+
# label = p.signif & p.format
labs(x=NULL,y=NULL)+
theme(axis.title = element_blank(),
axis.text.x=element_text(angle =45,hjust =1,vjust =1,color="black",size = 10,margin = margin(b =2)),
axis.text.y=element_text(color="black",size = 10,margin = margin(r =1)),
panel.background = element_rect(fill = NA,color = NA),
panel.grid.minor= element_line(size=0.2,color="#e5e5e5"),
panel.grid.major = element_line(size=0.2,color="#e5e5e5"),
panel.border = element_rect(fill=NA,color="black",size=1,linetype="solid"),
legend.key=element_blank(),
legend.title = element_text(color="black",size=10),
legend.text = element_text(color="black",size=8),
legend.spacing.x=unit(0.1,'cm'),
legend.key.width=unit(0.5,'cm'),
legend.key.height=unit(0.5,'cm'),
legend.box.background=element_rect(colour = "black"),
legend.position = c(1,0), legend.justification = c(1,0),
legend.background=element_blank())
a
dat <- read_tsv("f6C.txt")
dat$lncRNA_signature <- factor(dat$lncRNA_signature,levels = c("low-risk","high-risk"))
groups <- unique(dat$group)
plots = list()
for(group_ in groups) {
plots[[group_]] <-ggplot(dat %>%filter(group ==group_),
aes(x=lncRNA_signature,y=Intratumor_CD20),alpha=0.5) +
stat_boxplot(geom="errorbar",position=position_dodge(width=0.2),width=0.1)+
geom_boxplot(position=position_dodge(width =0.2),width=0.4)+
geom_jitter(aes(fill=lncRNA_signature,group=group,size=1,alpha=0.8),pch=21)+
scale_size_continuous(range=c(1,3))+
stat_compare_means(aes(group = lncRNA_signature), label = "p.format",method="t.test")+
scale_fill_manual(values = c("#000091","#ea5a49"))+
scale_x_discrete(guide = "prism_bracket")+
scale_y_continuous(labels = label_number(scale = 1e-3))+
labs(x=NULL,y="Stromal CD20+ B cell count\n(10e3/mm2)")+
theme_prism(base_line_size =0.5)+
theme(plot.margin=unit(c(0,0,0.5,0),units=,"cm"),
axis.line = element_line(color = "black",size = 0.4),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(size = 0.2,color = "#e5e5e5"),
axis.text.y = element_text(color="black",size=8),
axis.text.x = element_text(margin = margin(t = -5),color="black",size=8),
axis.title.y=element_text(color="black",size=10),
legend.position = "none",
panel.spacing = unit(0,"lines"))+
coord_cartesian()
print(plots[[group_]])
}
b <- patchwork::wrap_plots(plots,nrow=1)
(a/b)+ plot_layout(height=c(1.2,0.9))
ggsave("组合图.pdf",width = 6,height = 10,dpi = 300)
ggsave("组合图.pdf",width = 6,height = 6,dpi = 300)
# ==================== 加载包 ====================
library(tidyverse)     # 数据处理和绘图（含 dplyr、tidyr、ggplot2、readr）
library(introdataviz)  # 提供 geom_split_violin()，绘制分割小提琴图
library(ggpubr)        # 提供 stat_compare_means() 等绘图工具
library(ggsci)         # 期刊配色（JCO、NPG 等）
library(ggprism)       # Prism 风格主题和坐标轴
library(scales)        # 提供 label_number() 等数值格式化函数
library(patchwork)     # 图形组合
# ==================== 读取并整理数据 ====================
dd2 <- read_tsv("F6.txt") %>%              # 读取数据
pivot_longer(-lncRNA_signature)          # 宽转长：除 lncRNA_signature 外都转成长表
# 结果：lncRNA_signature、name、value 三列
colors <- c("#5a72b5", "#ea5a49")          # 定义 2 种颜色：蓝、红
# ==================== 绘制分割小提琴图 a ====================
a <- ggplot(dd2, aes(x = name,                # x 轴：name
y = value,               # y 轴：value
fill = lncRNA_signature)) +  # 填充色按 lncRNA_signature 映射
geom_split_violin(trim = F,                 # 分割小提琴图，不裁剪尾部
color = NA,               # 边框透明
adjust = 1.5) +           # 密度平滑度（越大越平滑）
guides(fill = guide_legend(title = "group")) +  # 图例标题设为 group
scale_fill_manual(values = colors) +        # 手动指定填充色
# ---- 均值 ± 标准差误差棒 ----
stat_summary(fun.data = "mean_sd",          # 统计函数：均值 ± 标准差
position = position_dodge(0.15),  # 躲开宽度 0.15
geom = "errorbar",             # 用误差棒显示
width = .1) +                  # 误差棒宽度
# ---- 均值点 ----
stat_summary(fun = "mean",                  # 统计函数：均值
geom = "point",                # 用点显示
position = position_dodge(0.15),  # 躲开
show.legend = F) +             # 不显示图例
# ---- 显著性标注 ----
stat_compare_means(aes(group = lncRNA_signature),  # 按 lncRNA_signature 分组比较
label = "p.signif",      # 显示显著性符号
label.y = 12,            # y 位置 12
method = "t.test") +     # t 检验
# ---- 轴标签 ----
labs(x = NULL, y = NULL) +                  # 不显示轴标签
# ---- 主题设置 ----
theme(
axis.title = element_blank(),             # 不显示轴标题
axis.text.x = element_text(angle = 45,    # x 轴文字旋转 45 度
hjust = 1,     # 水平对齐
vjust = 1,     # 垂直对齐
color = "black",  # 黑色
size = 5,     # 字号 10
margin = margin(b = 2)),  # 下边距
axis.text.y = element_text(color = "black",  # y 轴文字黑色
size = 10,     # 字号 10
margin = margin(r = 1)),  # 右边距
panel.background = element_rect(fill = NA, color = NA),  # 面板背景透明
panel.grid.minor = element_line(size = 0.2, color = "#e5e5e5"),  # 次网格线
panel.grid.major = element_line(size = 0.2, color = "#e5e5e5"),  # 主网格线
panel.border = element_rect(fill = NA, color = "black",  # 面板边框
size = 1, linetype = "solid"),  # 黑色实线
legend.key = element_blank(),             # 图例键背景透明
legend.title = element_text(color = "black", size = 10),  # 图例标题
legend.text = element_text(color = "black", size = 8),    # 图例文字
legend.spacing.x = unit(0.1, 'cm'),       # 图例水平间距
legend.key.width = unit(0.5, 'cm'),       # 图例键宽度
legend.key.height = unit(0.5, 'cm'),      # 图例键高度
legend.box.background = element_rect(colour = "black"),   # 图例边框
legend.position = c(1, 0),                # 图例位置：右下角
legend.justification = c(1, 0),           # 图例对齐：右下角
legend.background = element_blank()       # 图例背景透明
)
a   # 显示图形
# ==================== 加载包 ====================
library(tidyverse)     # 数据处理和绘图（含 dplyr、tidyr、ggplot2、readr）
library(introdataviz)  # 提供 geom_split_violin()，绘制分割小提琴图
library(ggpubr)        # 提供 stat_compare_means() 等绘图工具
library(ggsci)         # 期刊配色（JCO、NPG 等）
library(ggprism)       # Prism 风格主题和坐标轴
library(scales)        # 提供 label_number() 等数值格式化函数
library(patchwork)     # 图形组合
# ==================== 读取并整理数据 ====================
dd2 <- read_tsv("F6.txt") %>%              # 读取数据
pivot_longer(-lncRNA_signature)          # 宽转长：除 lncRNA_signature 外都转成长表
colors <- c("#5a72b5", "#ea5a49")          # 定义 2 种颜色：蓝、红
# ==================== 绘制分割小提琴图 a ====================
a <- ggplot(dd2, aes(x = name,                # x 轴：name
y = value,               # y 轴：value
fill = lncRNA_signature)) +  # 填充色按 lncRNA_signature 映射
geom_split_violin(trim = F,                 # 分割小提琴图，不裁剪尾部
color = NA,               # 边框透明
adjust = 1.5) +           # 密度平滑度（越大越平滑）
guides(fill = guide_legend(title = "group")) +  # 图例标题设为 group
scale_fill_manual(values = colors) +        # 手动指定填充色
# ---- 均值 ± 标准差误差棒 ----
stat_summary(fun.data = "mean_sd",          # 统计函数：均值 ± 标准差
position = position_dodge(0.15),  # 躲开宽度 0.15
geom = "errorbar",             # 用误差棒显示
width = .1) +                  # 误差棒宽度
# ---- 均值点 ----
stat_summary(fun = "mean",                  # 统计函数：均值
geom = "point",                # 用点显示
position = position_dodge(0.15),  # 躲开
show.legend = F) +             # 不显示图例
# ---- 显著性标注 ----
stat_compare_means(aes(group = lncRNA_signature),  # 按 lncRNA_signature 分组比较
label = "p.signif",      # 显示显著性符号
label.y = 12,            # y 位置 12
method = "t.test") +     # t 检验
# ---- 轴标签 ----
labs(x = NULL, y = NULL) +                  # 不显示轴标签
# ---- 主题设置 ----
theme(
axis.title = element_blank(),             # 不显示轴标题
axis.text.x = element_text(angle = 45,    # x 轴文字旋转 45 度
hjust = 1,     # 水平对齐
vjust = 1,     # 垂直对齐
color = "black",  # 黑色
size = 5,     # 字号 10
margin = margin(b = 2)),  # 下边距
axis.text.y = element_text(color = "black",  # y 轴文字黑色
size = 10,     # 字号 10
margin = margin(r = 1)),  # 右边距
panel.background = element_rect(fill = NA, color = NA),  # 面板背景透明
panel.grid.minor = element_line(size = 0.2, color = "#e5e5e5"),  # 次网格线
panel.grid.major = element_line(size = 0.2, color = "#e5e5e5"),  # 主网格线
panel.border = element_rect(fill = NA, color = "black",  # 面板边框
size = 1, linetype = "solid"),  # 黑色实线
legend.key = element_blank(),             # 图例键背景透明
legend.title = element_text(color = "black", size = 10),  # 图例标题
legend.text = element_text(color = "black", size = 8),    # 图例文字
legend.spacing.x = unit(0.1, 'cm'),       # 图例水平间距
legend.key.width = unit(0.5, 'cm'),       # 图例键宽度
legend.key.height = unit(0.5, 'cm'),      # 图例键高度
legend.box.background = element_rect(colour = "black"),   # 图例边框
legend.position = c(1, 0),                # 图例位置：右下角
legend.justification = c(1, 0),           # 图例对齐：右下角
legend.background = element_blank()       # 图例背景透明
)
a   # 显示图形
# ==================== 读取箱线图数据 ====================
dat <- read_tsv("f6C.txt")                    # 读取数据
dat$lncRNA_signature <- factor(dat$lncRNA_signature,   # lncRNA_signature 转因子
levels = c("low-risk", "high-risk"))  # 固定顺序
groups <- unique(dat$group)                   # 提取所有分组
plots <- list()                               # 创建空列表存放图形
# ==================== 循环绘制每个分组的箱线图 ====================
for (group_ in groups) {                      # 遍历每个分组
plots[[group_]] <- ggplot(
dat %>% filter(group == group_),          # 只取当前分组的数据
aes(x = lncRNA_signature,                 # x 轴：lncRNA_signature
y = Intratumor_CD20),                 # y 轴：Intratumor_CD20
alpha = 0.5) +                            # 透明度 0.5
# ---- 误差棒 ----
stat_boxplot(geom = "errorbar",           # 用误差棒显示
position = position_dodge(width = 0.2),  # 躲开 0.2
width = 0.1) +               # 误差棒宽度
# ---- 箱线图 ----
geom_boxplot(position = position_dodge(width = 0.2),  # 躲开 0.2
width = 0.4) +               # 箱体宽度
# ---- 散点 ----
geom_jitter(aes(fill = lncRNA_signature,  # 填充色按 lncRNA_signature
group = group,            # 分组
size = 1,                 # 大小 1
alpha = 0.8),             # 透明度 0.8
pch = 21) +                   # 形状：21 是带填充的圆
scale_size_continuous(range = c(1, 3)) +  # 点大小范围
# ---- 显著性标注 ----
stat_compare_means(aes(group = lncRNA_signature),  # 按 lncRNA_signature 分组比较
label = "p.format",    # 显示具体 p 值
method = "t.test") +   # t 检验
# ---- 配色 ----
scale_fill_manual(values = c("#000091", "#ea5a49")) +  # 手动填充色
# ---- 坐标轴 ----
scale_x_discrete(guide = "prism_bracket") +  # Prism 风格括号
scale_y_continuous(labels = label_number(scale = 1e-3)) +  # y 轴数值 ×1000
labs(x = NULL, y = "Stromal CD20+ B cell count\n(10e3/mm2)") +  # y 轴标签
# ---- 主题 ----
theme_prism(base_line_size = 0.5) +       # Prism 主题
theme(
plot.margin = unit(c(0, 0, 0.5, 0), units = "cm"),  # 图形边距
axis.line = element_line(color = "black", size = 0.4),  # 轴线
panel.grid.minor = element_blank(),     # 不显示次网格线
panel.grid.major = element_line(size = 0.2, color = "#e5e5e5"),  # 主网格线
axis.text.y = element_text(color = "black", size = 8),   # y 轴文字
axis.text.x = element_text(margin = margin(t = -5),      # x 轴文字
color = "black", size = 4),
axis.title.y = element_text(color = "black", size = 10), # y 轴标题
legend.position = "none",               # 不显示图例
panel.spacing = unit(0, "lines")        # 分面间距 0
) +
coord_cartesian()                         # 保持坐标范围
print(plots[[group_]])                      # 打印当前图形
}
# ==================== 组合箱线图 b ====================
b <- patchwork::wrap_plots(plots, nrow = 1)   # 把所有箱线图横向拼成一行
# ==================== 组合 a 和 b ====================
(a / b) + plot_layout(height = c(1.2, 0.9))
# ==================== 保存图片 ====================
ggsave("组合图.pdf", width = 6, height = 6, dpi = 300)
