hjust = 1,     # 水平对齐
vjust = 1,     # 垂直对齐
color = "black",  # 黑色
size = 5,     # 字号 10
margin = margin(b = 2)),  # 下边距
axis.text.y = element_text(color = "black",  # y 轴文字黑色
size = 10,     # 字号 10
margin = margin(r = 1)),  # 右边距
panel.background = element_rect(fill = NA, color = NA),  # 面板背景透明
panel.grid.minor = element_line(size = 0.2, color = "#e5e5e5"),  # 次网格线
panel.grid.major = element_line(size = 0.2, color = "#e5e5e5"),  # 主网格线
panel.border = element_rect(fill = NA, color = "black",  # 面板边框
size = 1, linetype = "solid"),  # 黑色实线
legend.key = element_blank(),             # 图例键背景透明
legend.title = element_text(color = "black", size = 10),  # 图例标题
legend.text = element_text(color = "black", size = 8),    # 图例文字
legend.spacing.x = unit(0.1, 'cm'),       # 图例水平间距
legend.key.width = unit(0.5, 'cm'),       # 图例键宽度
legend.key.height = unit(0.5, 'cm'),      # 图例键高度
